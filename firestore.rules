// ===============================================================
// CMFlow Firestore Security Rules — Production Hardened
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ===============================================================
    // User-scoped data: Isolation étanche par utilisateur
    // ===============================================================

    match /users/{userId} {

      allow read, write: if false;

      // --- Profile (Protection contre l'élévation de privilèges) ---
      match /data/profile {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
        // Un utilisateur ne peut pas s'auto-promouvoir admin ou modifier son rôle
        allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                      || isAdmin();
        allow delete: if isAdmin();
      }

      // --- Workspace & Préférences ---
      match /data/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && docId in ['workspace', 'prefs']) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Clients ---
      match /clients/{clientId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.keys().hasAll(['name'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200;
        allow update: if isOwner(userId)
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Posts ---
      match /posts/{postId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.keys().hasAll(['caption', 'status'])
                      && request.resource.data.caption is string
                      && request.resource.data.caption.size() <= 5000
                      && request.resource.data.status in ['draft', 'pending', 'scheduled', 'published'];
        allow update: if isOwner(userId)
                      && request.resource.data.status in ['draft', 'pending', 'scheduled', 'published'];
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Settings ---
      match /settings/{settingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ===============================================================
    // Deny everything else by default
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
