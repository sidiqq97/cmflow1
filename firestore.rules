// ===============================================================
// CMFlow Firestore Security Rules — Production Hardened v2
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@cmflow.sn' ||
        request.auth.token.email == 'sidiqq97@gmail.com'
      );
    }

    // ===============================================================
    // User-scoped data: Isolation étanche par utilisateur
    // ===============================================================

    match /users/{userId} {

      allow read, write: if false;

      // --- Profile (Verrouillage strict du Plan Pro & Rôle Admin) ---
      match /data/profile {
        allow read: if isOwner(userId) || isAdmin();
        
        // À la création, seul le plan 'trial' et le rôle 'user' sont autorisés
        allow create: if isOwner(userId)
                      && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user')
                      && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'trial');
        
        // À la mise à jour, l'utilisateur ne peut PAS modifier son plan ni son rôle
        allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'subscriptionExpiresAt']))
                      || isAdmin();
        
        allow delete: if isAdmin();
      }

      // --- Workspace & Préférences ---
      match /data/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && docId in ['workspace', 'prefs']) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Clients ---
      match /clients/{clientId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.keys().hasAll(['name'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200;
        allow update: if isOwner(userId)
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Posts ---
      match /posts/{postId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.keys().hasAll(['caption', 'status'])
                      && request.resource.data.caption is string
                      && request.resource.data.caption.size() <= 5000
                      && request.resource.data.status in ['draft', 'pending', 'scheduled', 'published'];
        allow update: if isOwner(userId)
                      && request.resource.data.status in ['draft', 'pending', 'scheduled', 'published'];
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Settings ---
      match /settings/{settingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ===============================================================
    // Partage & Validation Client Distante (Multi-Appareils WhatsApp)
    // ===============================================================
    match /public_reviews/{token} {
      // Lecture autorisée pour quiconque possède le lien signé
      allow read: if true;
      
      // Création et suppression réservées au CM propriétaire ou à l'Admin
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
      
      // Le client externe peut uniquement approuver ou laisser un commentaire
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientApproved', 'clientFeedback', 'updatedAt'])
                    && (!request.resource.data.keys().hasAny(['clientFeedback']) || (request.resource.data.clientFeedback is string && request.resource.data.clientFeedback.size() <= 1000));
    }

    // ===============================================================
    // Deny everything else by default
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
