{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v/:token",
      "destination": "/client-review.html"
    },
    {
      "source": "/approve/:token",
      "destination": "/client-review.html"
    }
  ]
}
